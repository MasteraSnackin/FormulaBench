# Optional baseline-development template only. Production does not read .env automatically.
# Export TINKER_API_KEY in the private shell that starts the production run. Never commit a key.
TINKER_API_KEY=
# Optional: select a known writable project when the account's Default project is read-only.
TINKER_PROJECT_ID=
# Production forces Tinker SDK telemetry off; this file cannot override that policy.
