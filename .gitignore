.DS_Store
.env
.env.*
!.env.example
.venv/
.pytest_cache/
.ruff_cache/
**/__pycache__/
**/*.py[cod]

# Local presentation work and authenticated screenshots are never published.
.tmp-presentation/

# Keep the reproducible HyperFrames source, but exclude generated caches and renders.
videos/**/node_modules/
videos/**/.hyperframes/
videos/**/.thumbnails/
videos/**/.waveform-cache/
videos/**/capture/
videos/**/renders/
videos/**/snapshots/

data/spreadsheetbench_verified_400/
training/generated/
training/runs/
submissions/*/
!submissions/.gitkeep
!submissions/formulabench/
!submissions/formulabench/predictions.jsonl
!submissions/formulabench/run.log
!submissions/formulabench/results.json
!submissions/formulabench/outputs/
!submissions/formulabench/outputs/*.xlsx
!submissions/formulabench/traces/
!submissions/formulabench/traces/*.jsonl

# The canonical final run under submissions/formulabench is intentionally not ignored.
